//@version=5
indicator("Weinstein BO Event", overlay=true)

maLen = input.int(30, "MA Length")
resLen = input.int(30, "Resistance Lookback")

ma30 = ta.sma(close, maLen)
plot(ma30, title="MA30", color=color.blue, linewidth=2)

resistance = ta.highest(high[1], resLen)
plot(resistance, title="Resistance", color=color.orange, linewidth=2)

// 상태
aboveMA = close > ma30
aboveResistance = close > resistance

// 거래량 규칙
volRule1 = false
volRule2 = false

if timeframe.isweekly and bar_index >= 4
    avg4 = (volume[1] + volume[2] + volume[3] + volume[4]) / 4.0
    volRule1 := volume >= avg4 * 2.0

if timeframe.isweekly and bar_index >= 7
    recent4 = volume + volume[1] + volume[2] + volume[3]
    prev4   = volume[4] + volume[5] + volume[6] + volume[7]
    volRule2 := recent4 >= prev4 * 2.0

if timeframe.isdaily and bar_index >= 5
    avg5 = (volume[1] + volume[2] + volume[3] + volume[4] + volume[5]) / 5.0
    volRule1 := volume >= avg5 * 2.0

volOk = volRule1 or volRule2

// 돌파 이벤트: 이전 봉은 저항선 아래, 현재 봉은 저항선 위
breakoutRes = close > resistance and close[1] <= resistance[1]

// 최종 BO
bo = breakoutRes and close > ma30 and volOk

plotshape(bo, title="BO", style=shape.labelup, location=location.belowbar, color=color.lime, text="BO", textcolor=color.black, size=size.small)
bgcolor(bo ? color.new(color.green, 88) : na)

// =====================
// 마지막 BO 봉 정보 저장
// =====================
var int lastBoBar = na
var bool lastBoMA = na
var bool lastBoRes = na
var bool lastBoVol1 = na
var bool lastBoVol2 = na

if bo
    lastBoBar := bar_index
    lastBoMA := close > ma30
    lastBoRes := close > resistance
    lastBoVol1 := volRule1
    lastBoVol2 := volRule2

barsSinceBo = na(lastBoBar) ? na : bar_index - lastBoBar

// 표
var table t = table.new(position.top_right, 2, 5, border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "최근 BO 몇 봉 전", text_color=color.white, bgcolor=color.black)
    table.cell(t, 1, 0, na(barsSinceBo) ? "없음" : str.tostring(barsSinceBo), text_color=color.white, bgcolor=na(barsSinceBo) ? color.red : color.new(color.blue, 0))

    table.cell(t, 0, 1, "BO봉 MA30 위", text_color=color.white, bgcolor=color.black)
    table.cell(t, 1, 1, na(lastBoMA) ? "없음" : (lastBoMA ? "YES" : "NO"), text_color=color.white, bgcolor=na(lastBoMA) ? color.red : (lastBoMA ? color.green : color.red))

    table.cell(t, 0, 2, "BO봉 저항선 위", text_color=color.white, bgcolor=color.black)
    table.cell(t, 1, 2, na(lastBoRes) ? "없음" : (lastBoRes ? "YES" : "NO"), text_color=color.white, bgcolor=na(lastBoRes) ? color.red : (lastBoRes ? color.green : color.red))

    table.cell(t, 0, 3, "BO봉 거래량 규칙1", text_color=color.white, bgcolor=color.black)
    table.cell(t, 1, 3, na(lastBoVol1) ? "없음" : (lastBoVol1 ? "YES" : "NO"), text_color=color.white, bgcolor=na(lastBoVol1) ? color.red : (lastBoVol1 ? color.green : color.red))

    table.cell(t, 0, 4, "BO봉 거래량 규칙2", text_color=color.white, bgcolor=color.black)
    table.cell(t, 1, 4, na(lastBoVol2) ? "없음" : (lastBoVol2 ? "YES" : "NO"), text_color=color.white, bgcolor=na(lastBoVol2) ? color.red : (lastBoVol2 ? color.green : color.red))